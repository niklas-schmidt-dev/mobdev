{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mobdev-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mobdev.sh", "custom_domain": true }],
  "workers_dev": false,
  // Same database as relay/wrangler.jsonc.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobdev",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Lets the dashboard disconnect Macs when a token is revoked. Not reachable over HTTP.
  "services": [{ "binding": "RELAY", "service": "mobdev-relay", "entrypoint": "RelayAdmin" }],
  "vars": {
    // WorkOS project "Mobdev", environment "Production".
    "WORKOS_CLIENT_ID": "client_01M3PBNSYHV4KWR86PW67T7QMK",
    "RELAY_URL": "https://relay.mobdev.sh",
    "WORKOS_REDIRECT_URI": "https://mobdev.sh/api/auth/callback"
  },
  // Secrets (wrangler secret put): WORKOS_API_KEY, WORKOS_COOKIE_PASSWORD.
  "observability": { "enabled": true }
}
