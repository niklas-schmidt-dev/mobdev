{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mobdev-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "relay.mobdev.sh", "custom_domain": true }],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "RELAY_SPACE", "class_name": "RelaySpace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelaySpace"] }],
  // Production database; same ID as ../wrangler.jsonc.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobdev",
      "database_id": "f79069d6-9e8e-4ea4-8b50-a6a0f5fd6ba9",
      "migrations_dir": "../migrations"
    }
  ],
  // Per location and approximate; the monthly allowance in Autumn is the real limit.
  // AGENT_LIMIT must match AGENT_BURST in src/protocol.ts.
  "ratelimits": [
    { "name": "AGENT_LIMIT", "namespace_id": "4101", "simple": { "limit": 50, "period": 10 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } }
  ],
  // Secrets (wrangler secret put -c relay/wrangler.jsonc): AUTUMN_SECRET_KEY. Without it the relay
  // neither meters nor bills.
  // Every agent request logs about three events; keeping 1 in 20 keeps logs from dominating cost.
  "observability": { "enabled": true, "head_sampling_rate": 0.05 }
}
