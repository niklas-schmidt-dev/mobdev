{
  "name": "mobdev-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port ${PORT:-3000} --host ${HOST:-127.0.0.1} --strictPort",
    "dev:relay": "wrangler dev -c relay/wrangler.jsonc --port ${PORT:-8787} --ip ${HOST:-127.0.0.1} --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply mobdev --local --persist-to .wrangler/state",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface Env && wrangler types -c relay/wrangler.jsonc --env-interface RelayEnv relay/worker-configuration.d.ts",
    "deploy:relay": "wrangler deploy -c relay/wrangler.jsonc",
    "deploy:web": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "@workos-inc/node": "^10.14.0",
    "@workos/authkit-tanstack-react-start": "^0.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/vitest-plugin": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "~4.1.0",
    "wrangler": "^4.142.0"
  }
}
