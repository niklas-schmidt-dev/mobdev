# Copy to .dev.vars for `bun run dev`. Values come from the WorkOS "Mobdev" project, environment "Staging".
WORKOS_CLIENT_ID=client_01M3PBNSNZJ23ZRQJSBMQ8QEW9
WORKOS_API_KEY=sk_test_...
WORKOS_COOKIE_PASSWORD=at-least-32-characters-of-randomness
WORKOS_REDIRECT_URI=https://web.<namespace>.localhost/api/auth/callback
RELAY_URL=https://relay.<namespace>.localhost
# Optional: an Autumn sandbox secret key (am_sk_test_…). Empty turns billing off. The relay reads its
# own copy from relay/.dev.vars.
AUTUMN_SECRET_KEY=
