{
  "name": "mobdev",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source mobile device workbench for humans and AI agents",
  "license": "MIT",
  "author": "Mobdev contributors",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "start": "electron .",
    "daemon": "node --import tsx src/cli/main.ts serve",
    "cli": "node --import tsx src/cli/main.ts",
    "mcp": "node --import tsx src/cli/mcp.ts",
    "package": "bun run build && electron-builder --publish never"
  },
  "build": {
    "appId": "dev.mobdev.desktop",
    "productName": "Mobdev",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "LICENSE"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "dist/cli",
        "to": "cli"
      }
    ],
    "icon": "build/icon.png"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.41.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3"
  }
}
